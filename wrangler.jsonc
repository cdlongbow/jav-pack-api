{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jav-pack-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "routes": [
    {
      "pattern": "javp.cc.cd",
      "custom_domain": true,
    },
    {
      "pattern": "jav.qzz.io",
      "custom_domain": true,
    },
  ],
  "cache": {
    "enabled": true,
  },
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "vars": {
    "TTL_HIT": 86400,
    "TTL_MISS": 300,
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "d53c998b99f64dd68b8dc2384f316b93",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jav-pack-api-db",
      "database_id": "20a825f1-f4e2-4289-8a4c-1fec6d4b8105",
    },
  ],
}
