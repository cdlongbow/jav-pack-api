{
  "name": "jav-pack-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --env-interface CloudflareBindings",
    "check": "pnpm types --check && oxfmt --check && oxlint",
    "fix": "pnpm types && oxlint --fix && oxfmt",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "predeploy": "pnpm check",
    "deploy": "wrangler deploy --minify"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "wrangler": "^4.151.1"
  },
  "packageManager": "pnpm@12.14.0"
}
