{
  "name": "jav-pack-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --env-interface CloudflareBindings",
    "check": "pnpm types --check && oxfmt --check && oxlint",
    "fix": "pnpm types && oxlint --fix && oxfmt",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "predeploy": "pnpm check",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "wrangler": "^4.123.0"
  },
  "packageManager": "pnpm@11.21.0"
}
