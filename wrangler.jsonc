{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jav-pack-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": false,
  "minify": true,
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "javp.cc.cd",
      "custom_domain": true
    },
    {
      "pattern": "jav.qzz.io",
      "custom_domain": true
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "d53c998b99f64dd68b8dc2384f316b93"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jav-pack-api-db",
      "database_id": "2b6aa7ce-3305-4a35-a2e5-89b2b26a26bb"
    }
  ]
}
