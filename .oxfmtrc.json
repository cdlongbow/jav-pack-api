{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["worker-configuration.d.ts"],
  "printWidth": 120,
  "quoteProps": "consistent",
  "sortImports": true,
  "overrides": [
    {
      "files": ["**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
